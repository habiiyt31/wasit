# Both agents need this — your deployed WasitFactory address.
WASIT_FACTORY_ADDRESS=

# --- buyer-agent.ts ---
BUYER_AGENT_PRIVATE_KEY=
SELLER_AGENT_ADDRESS=
ARBITER_ADDRESS=
# Optional — defaults to the buyer's own address if unset.
TREASURY_ADDRESS=

# --- seller-agent.ts ---
SELLER_AGENT_PRIVATE_KEY=

# Generate a fresh private key for each agent with (run inside agents/,
# after `npm install`, so genlayer-js resolves):
#   node --input-type=module -e "import {generatePrivateKey} from 'genlayer-js'; console.log(generatePrivateKey())"
# Fund each resulting address via Studio's faucet before running either
# agent — an agent with no GEN can't pay gas any more than a human can.
