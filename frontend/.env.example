# Which GenLayer network to talk to.
# One of: studioNext | studionet | localnet | testnetAsimov | testnetBradbury
#
# studioNext is the Consensus v0.6 network the Agent Tank hackathon runs
# on (chain ID 61997). Its RPC and explorer are pinned in lib/genlayer.ts
# rather than read from env vars, so they can never drift out of sync
# with the chain ID.
NEXT_PUBLIC_GENLAYER_NETWORK=studioNext

NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio-dev.genlayer.com

# The deployed Wasit contract. There is only one — arbiters and every
# escrow live inside it. Paste the address exactly as the deploy printed
# it; do not change its casing (see the note in lib/genlayer.ts).
NEXT_PUBLIC_WASIT_ADDRESS=

# Optional: pre-fills the "protocol fee goes to" field when creating an
# escrow. Leave blank to default to the connected wallet.
NEXT_PUBLIC_DEFAULT_TREASURY_ADDRESS=
