# One of: "studionet" | "localnet" | "testnetAsimov" | "testnetBradbury"
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Studionet (hosted dev environment — no local setup required)
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_CHAIN_ID=61999
NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio.genlayer.com

# Set after running `npm run network` + deploying wasit_factory.py
# (Hari 4 in the roadmap), or paste in manually. Paste it exactly as
# printed — don't change its casing. See lib/genlayer.ts for why.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Optional: pre-fills the "protocol fee treasury" field on /create so
# buyers don't have to know/paste it themselves every time. Leave
# blank to require manual entry.
NEXT_PUBLIC_DEFAULT_TREASURY_ADDRESS=
